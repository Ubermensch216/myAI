# myAI environment configuration example.
# Copy to .env and fill in secrets before starting the server.
# Variables with a default shown are optional; omit or leave empty to use the default.
# Variables with an empty value are required (or conditionally required as noted).

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# TLS (optional; leave empty to use plain HTTP)
# Provide all three to enable HTTPS. CA cert is optional even with TLS.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=
HTTPS_CA_PATH=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
# Main generation model. Pull with: ollama pull gemma4:e2b
OLLAMA_MODEL=gemma4:e2b

# Embeddings
# Pull with: ollama pull bge-m3
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# Image generation (optional; runs as a separate Python worker, see docs/IMAGE_GENERATION_PLAN.md)
# Leave the worker offline to disable image features — chat and infographic "fast" mode keep working.
# Provider swap point: diffusers (MVP) | comfyui (future). Node never calls the worker directly except
# through server/imageGeneration/imageProvider.js.
IMAGE_PROVIDER=diffusers
IMAGE_WORKER_URL=http://127.0.0.1:7861
# Hardware tier picks the default model/size/steps. auto = worker detects VRAM and chooses.
# auto | cpu | low | mid | high | max  (default low = minimum spec, SD-Turbo)
IMAGE_MODEL_TIER=low
# Override the tier's model entirely (e.g. black-forest-labs/FLUX.1-schnell). Empty = tier default.
IMAGE_MODEL=
IMAGE_MAX_WIDTH=1024
IMAGE_MAX_HEIGHT=1024
IMAGE_MAX_BATCH=4
# Generated PNGs are server temp files; deleted after this many hours.
IMAGE_RETENTION_HOURS=24
# Image queue is separate from text queues; concurrency 1 protects VRAM.
IMAGE_QUEUE_CONCURRENCY=1
IMAGE_QUEUE_MAX_QUEUED=16
IMAGE_GEN_TIMEOUT_MS=180000
IMAGE_DAILY_LIMIT_PER_USER=50
# Hugging Face token for admin model downloads; must remain server-side only.
HUGGINGFACE_TOKEN=
# ComfyUI provider (only used when IMAGE_PROVIDER=comfyui). Pin a workflow JSON and
# keep custom nodes on an allowlist. Placeholder tokens in the workflow
# (%PROMPT% %NEGATIVE% %WIDTH% %HEIGHT% %STEPS% %SEED% %BATCH%) are substituted per request.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_TEXT2IMG=

# Admin
# Required to use notebook management endpoints (/api/admin/*).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Access control
# Secret used to sign per-user access tokens. Generate with: openssl rand -hex 32
# Leave empty to disable access-token gating (anyone who can reach the server has access).
ACCESS_TOKEN_SECRET=
# Token lifetime in seconds (default: 43200 = 12 hours)
ACCESS_TOKEN_TTL_SECONDS=43200

# Request limits
MAX_JSON_BYTES=80mb
# 40 MB in bytes
MAX_UPLOAD_BYTES=41943040
MAX_CONTEXT_CHARS=24000
NOTEBOOK_QUERY_BUDGET=12000

# Personal-document cache (browser docs persist in IndexedDB on the client)
# TTL in ms (default: 21600000 = 6 hours)
DOCUMENT_CACHE_TTL_MS=21600000
DOCUMENT_CACHE_MAX_ENTRIES=256

# Department RAG backends
# vector:  json (no external service) | qdrant (requires Qdrant running)
# lexical: memory (no external service) | sqlite (requires Node.js 24+)
DEPARTMENT_VECTOR_BACKEND=json
DEPARTMENT_LEXICAL_BACKEND=memory

# Qdrant (required when DEPARTMENT_VECTOR_BACKEND=qdrant)
# Start Qdrant: docker compose -f deploy/docker-compose.department.yml up -d
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=myai_notebook_chunks
QDRANT_VECTOR_NAME=dense_bge_m3
QDRANT_TIMEOUT_MS=2500
QDRANT_SEARCH_LIMIT=48
QDRANT_UPSERT_BATCH_SIZE=128

# SQLite FTS (required when DEPARTMENT_LEXICAL_BACKEND=sqlite)
# File is created automatically on first ingest.
SQLITE_FTS_PATH=data/indexes/department-rag.sqlite
SQLITE_FTS_SEARCH_LIMIT=80

# Document chunking
CHUNK_WINDOW_CHARS=1024
CHUNK_OVERLAP_CHARS=256

# Notebook ingest
NOTEBOOK_CHUNK_CACHE_MAX=4
EMBED_INGEST_BATCH_SIZE=16
EMBED_INGEST_MAX_ATTEMPTS=2

# Query expansion
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_VARIANTS=3
QUERY_EXPANSION_TIMEOUT_MS=6000

# Document analysis
DOC_ANALYSIS_ENABLED=true
DOC_ANALYSIS_MAX_INPUT_CHARS=12000
DOC_ANALYSIS_TIMEOUT_MS=30000

# Map-reduce summarisation
# Map batch timeout = MAP_REDUCE_MAP_TIMEOUT_MS + (batchSize × MAP_REDUCE_MAP_TIMEOUT_PER_CHUNK_MS)
#                    + (first batch only: MAP_REDUCE_COLD_START_MARGIN_MS), ×1.5 on retry
MAP_REDUCE_BATCH_CHUNKS=4
MAP_REDUCE_MAX_CHUNKS=80
MAP_REDUCE_PARALLELISM=2
MAP_REDUCE_MAP_TIMEOUT_MS=120000
MAP_REDUCE_MAP_TIMEOUT_PER_CHUNK_MS=20000
MAP_REDUCE_COLD_START_MARGIN_MS=30000
MAP_REDUCE_MAP_RETRY=1
# Keep model resident in Ollama memory to avoid cold-start delays
OLLAMA_KEEP_ALIVE=30m

# Mindmap generation
# Leave MINDMAP_MODEL empty to reuse OLLAMA_MODEL.
MINDMAP_MODEL=
MINDMAP_P1_MAX_CONTEXT=12000
MINDMAP_P1_MAX_CHUNKS=10
MINDMAP_OUTLINE_MAX_ITEMS=28
MINDMAP_OLLAMA_TIMEOUT_MS=180000
MINDMAP_MAX_NODES=24
MINDMAP_MAX_EDGES=36

# Studio Document generation
# Leave STUDIO_DOCUMENT_FALLBACK_MODEL empty to reuse OLLAMA_MODEL.
STUDIO_DOCUMENT_FALLBACK_MODEL=
STUDIO_DOCUMENT_OLLAMA_TIMEOUT_MS=90000
STUDIO_DOCUMENT_MAX_BLOCKS=120
STUDIO_DOCUMENT_MAX_CHARS=180000
STUDIO_DOCUMENT_MAX_TABLE_ROWS=200
STUDIO_DOCUMENT_ANSWER_MAX_CHARS=120000

# Source workflow
SOURCE_GUIDE_INPUT_MAX_CHARS=36000
SOURCE_GUIDE_TIMEOUT_MS=75000
SOURCE_PROMOTION_MAX_CHARS=180000
GENERATED_SOURCE_MAX_CHARS=180000
GENERATED_SOURCE_BINARY_INLINE_MAX_BYTES=750000

# Export
EXPORT_MAX_CHARS=180000
# Override PDF Korean font path. Defaults to system Malgun Gothic / NotoSansKR.
EXPORT_PDF_FONT_PATH=

# Concurrency queues
EMBED_QUEUE_CONCURRENCY=2
EMBED_QUEUE_MAX_QUEUED=64
MAP_REDUCE_QUEUE_CONCURRENCY=2
MAP_REDUCE_QUEUE_MAX_QUEUED=32
ANALYSIS_QUEUE_CONCURRENCY=2
ANALYSIS_QUEUE_MAX_QUEUED=32
CHAT_QUEUE_ENABLED=false
CHAT_QUEUE_CONCURRENCY=4
CHAT_QUEUE_MAX_QUEUED=32

# Cross-encoder reranker (optional, requires Ollama /api/rerank support)
RAG_RERANK_ENABLED=false
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TOP_K=40
RERANK_TIMEOUT_MS=8000
RERANK_QUEUE_CONCURRENCY=1
RERANK_QUEUE_MAX_QUEUED=16

# Rate limits (requests per minute per client)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_VISUALIZE_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=8
RATE_LIMIT_LIGHTWEIGHT_PER_MINUTE=30
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=10
RATE_LIMIT_LAW_SEARCH_PER_MINUTE=15
RATE_LIMIT_LAW_ARTICLE_PER_MINUTE=20
RATE_LIMIT_LAW_VERIFY_PER_MINUTE=20
RATE_LIMIT_LAW_RESEARCH_PER_MINUTE=8
RATE_LIMIT_LAW_IMPACT_PER_MINUTE=4
RATE_LIMIT_LAW_TIME_TRAVEL_PER_MINUTE=4

# Reverse proxy
# Set TRUST_PROXY=true only when the app is behind a trusted proxy that
# overwrites X-Forwarded-* headers (e.g. nginx, Caddy).
TRUST_PROXY=false
# When TRUST_PROXY=true, rate-limit by a proxy-authenticated user header
# (e.g. x-forwarded-user) instead of client IP. Leave empty for per-IP limits.
RATE_LIMIT_KEY_HEADER=

# Retrieval logging
# Writes JSONL to data/logs/retrieval-YYYY-MM-DD.jsonl
RETRIEVAL_LOG_ENABLED=true

# Usage statistics logging
USAGE_LOG_ENABLED=true

# Knowledge Graph (optional)
# Build a graph for a notebook with:
#   node --env-file=.env scripts/build-notebook-graph.mjs <notebookId> --rebuild
# or POST /api/admin/graph/<notebookId>/rebuild from the Studio panel.
# Set KG_EXPANSION_ENABLED=1 to enable query-time graph expansion.
KG_EXPANSION_ENABLED=0
KG_EXPAND_TERMS=8
KG_EXPAND_NEIGHBORS=8
KG_EXPAND_REFS=4
KG_EXPAND_MAX=12
KG_FUSION_WEIGHT=0.3
# Leave KG_EXTRACT_MODEL empty to reuse OLLAMA_MODEL.
KG_EXTRACT_MODEL=
KG_EXTRACT_TEMPERATURE=0.1
KG_EXTRACT_TIMEOUT_MS=180000
KG_EXTRACT_MAX_CHARS=4000
KG_CONFIDENCE_THRESHOLD=0.6

# Korean Law Engine
# LAW_OC is the law.go.kr Open API key; must remain server-side only.
# Register at: https://open.law.go.kr/lsEfInfo.do
LAW_API_ENABLED=true
LAW_OC=
# Alternative env name for the same key (either works).
# KOREAN_LAW_API_KEY=
LAW_USER_AGENT=Mozilla/5.0 (compatible; myAI Korean Law Engine)
LAW_TIMEOUT_MS=8000
LAW_MAX_RESULTS=8
LAW_CONTEXT_BUDGET=10000
LAW_CACHE_ENABLED=true
LAW_CACHE_TTL_MS=86400000
LAW_CACHE_MAX_ENTRIES=1000
# SQLite file for law API response cache (created automatically).
LAW_CACHE_PATH=data/cache/law-cache.sqlite
LAW_AUTO_DETECT=false
LAW_VERIFY_CITATIONS=true
LAW_IMPACT_MAP_ENABLED=false
# eflaw (effective law, default) | eflaw+history
LAW_HISTORY_TARGET=eflaw

# Naver Search API (optional)
# Register at: https://developers.naver.com/apps
# Keep client ID and secret server-side only.
NAVER_SEARCH_ENABLED=true
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# Comma-separated types: news, webkr, blog, kin, cafearticle
NAVER_SEARCH_TYPES=news,webkr
NAVER_SEARCH_DISPLAY=5
NAVER_SEARCH_MAX_RESULTS=8
NAVER_SEARCH_TIMEOUT_MS=4500

# Korean Public Holiday API (optional)
# Register at: https://www.data.go.kr (Korean Public Data Portal)
KOREA_HOLIDAY_SERVICE_KEY=
