# Copy to .env and adjust as needed. .env is gitignored.

# Ollama HTTP endpoint
OLLAMA_URL=http://127.0.0.1:11434

# Default chat model. Pull it first with `ollama pull <name>`.
# Examples: gemma3n:e2b, gemma3:4b, llama3.2:3b, qwen2.5:7b
OLLAMA_MODEL=gemma3n:e2b

# Embedding model for semantic (vector) retrieval.
# Recommended for Korean retrieval: `ollama pull bge-m3`
# Alternative: `ollama pull nomic-embed-text`
# If not set or unavailable, retrieval silently falls back to BM25 keyword search.
EMBED_MODEL=bge-m3

# Optional: enforce embedding vector dimension at the embeddings.js boundary.
# When set, every /api/embed response is validated against this dim and
# requests that mismatch (e.g. accidentally swapping models) are rejected.
# Notebook ingest also records the inferred dim per notebook in manifest.json.
# Leave unset to infer dim from the first successful call.
# EMBED_DIM=1024

# Notebook ingest batching for embeddings. Lower if Ollama OOMs on large batches.
EMBED_INGEST_BATCH_SIZE=16
# Per-batch retry attempts before marking a batch as partially failed.
EMBED_INGEST_MAX_ATTEMPTS=2

# Retrieval JSONL logging at data/logs/retrieval-YYYY-MM-DD.jsonl. Records timing,
# corpus size, selected chunk ranks, and fallback reason. Query text and chunk
# text are NEVER stored — only a sha256(query) hash and length. Set to "false"
# to disable.
RETRIEVAL_LOG_ENABLED=true

# Optional: Public Data Portal service key for official Korean public holidays.
# Data source: KASI SpcdeInfoService/getRestDeInfo.
# Without this key the app shows a limited fixed-solar-holiday fallback.
# KOREA_HOLIDAY_SERVICE_KEY=

# Maximum characters of document context inlined into a chat request.
# When exceeded, the BM25 retriever picks the most relevant chunks for the user query.
MAX_CONTEXT_CHARS=24000

# Sliding-window chunking targets ~512 tokens / ~128 tokens overlap by default
# (assuming ~2 chars/token for mixed Korean/English text).
# Larger window = more context per chunk but coarser retrieval; larger overlap = better
# boundary recall at the cost of duplicated text. Tune for your embedding model.
CHUNK_WINDOW_CHARS=1024
CHUNK_OVERLAP_CHARS=256

# LLM-based query expansion for retrieval. When enabled, the active OLLAMA_MODEL
# rewrites each user query into a few synonym/perspective variants and the
# retriever fuses results across all variants via Reciprocal Rank Fusion.
# Trade-off: +1 Ollama call per RAG turn (~0.3-1s on local hardware) for higher
# recall on vague or domain-paraphrased questions. Set to false to disable.
QUERY_EXPANSION_ENABLED=true
# Number of paraphrase variants to generate (excluding the original query).
QUERY_EXPANSION_VARIANTS=3
# Abort the rewrite call after this many ms; on timeout the original query is used alone.
QUERY_EXPANSION_TIMEOUT_MS=6000

# Upload-time document pre-analysis. When enabled, the active OLLAMA_MODEL
# generates a 2~4 sentence Korean summary and a list of key topics for each
# uploaded document. The summary/topics are stored alongside the document and
# injected into chat context so questions like "이 문서 뭐야?" don't depend on
# RAG hitting the right chunk.
# Trade-off: +1 Ollama call per upload (~3-10s on local hardware). Set to false
# to skip and revert to chunk-only retrieval.
DOC_ANALYSIS_ENABLED=true
# Maximum characters of document body sent to the analysis prompt. Long bodies
# are sampled head-and-tail to fit. Tune up if your model has plenty of context.
DOC_ANALYSIS_MAX_INPUT_CHARS=12000
# Abort the analysis call after this many ms; on timeout the document is saved
# without summary/topics and the rest of the upload pipeline continues.
DOC_ANALYSIS_TIMEOUT_MS=30000

# Maximum characters of department-notebook context selected per chat turn.
NOTEBOOK_QUERY_BUDGET=12000

# Map-Reduce analysis mode. When the user toggles the "전체 분석" button in the
# composer, the chat call bypasses RAG retrieval and instead processes every
# chunk of the active notebook (or all attached files) in batched LLM calls
# (Map step), then merges the partial results into a single streamed answer
# (Reduce step). Trade-off: ~(MAX_CHUNKS / BATCH_CHUNKS / PARALLELISM) * map
# latency + 1 reduce stream. Suitable for whole-document questions like
# "전체 요약", "주요 쟁점 정리", "이 문서 톤 분석".
# Number of chunks combined into a single Map LLM call.
MAP_REDUCE_BATCH_CHUNKS=4
# Hard cap on chunks fed into a single analysis run; excess is dropped with a
# warning so a single click can't kick off a runaway job.
MAP_REDUCE_MAX_CHUNKS=80
# Concurrent in-flight Map calls. Raise on beefy GPUs, lower on low-VRAM hosts.
MAP_REDUCE_PARALLELISM=2
# Per-Map-call timeout. On timeout the batch is skipped and others continue.
MAP_REDUCE_MAP_TIMEOUT_MS=45000

# Admin token for managing department notebooks (창고).
# Required for POST/PATCH/DELETE on /api/notebooks and document uploads to notebooks.
# Generate a long random string. Leave unset to disable admin endpoints.
# Example: openssl rand -hex 32
# ADMIN_TOKEN=

# Express body / upload limits.
# Match these with reverse-proxy body limits in shared deployments.
MAX_JSON_BYTES=80mb
MAX_UPLOAD_BYTES=41943040

# Rate limiting is not built into the Node.js app. Configure it at the
# reverse proxy or network edge before exposing the app beyond a small trusted LAN.

# HTTP port.
PORT=3000

# HTTP bind host.
# Leave unset to listen on all interfaces (default — convenient for local dev).
# Set to 127.0.0.1 in production when sitting behind a reverse proxy
# so the app is not directly reachable from the public network.
# HOST=127.0.0.1
