# Department workstation example.
# Copy to .env and adjust host names, tokens, and limits for the workstation.

PORT=3000
HOST=127.0.0.1

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

ADMIN_TOKEN=replace-with-long-random-token

MAX_JSON_BYTES=80mb
MAX_UPLOAD_BYTES=41943040

DEPARTMENT_VECTOR_BACKEND=qdrant
DEPARTMENT_LEXICAL_BACKEND=sqlite
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=myai_notebook_chunks
QDRANT_VECTOR_NAME=dense_bge_m3
QDRANT_TIMEOUT_MS=2500
QDRANT_SEARCH_LIMIT=48
QDRANT_UPSERT_BATCH_SIZE=128
SQLITE_FTS_PATH=data/indexes/department-rag.sqlite
SQLITE_FTS_SEARCH_LIMIT=80

RETRIEVAL_LOG_ENABLED=true
