# Drop-in vhost for nginx. Pair with certbot for TLS:
#   sudo certbot --nginx -d myai.example.com
# Caddy is simpler if you do not already run nginx.

upstream myai_upstream {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name myai.example.com;

    # Redirect everything to HTTPS. WebCrypto AES-GCM in the frontend
    # requires a secure context, so plain HTTP is not usable.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name myai.example.com;

    # Managed by certbot:
    # ssl_certificate     /etc/letsencrypt/live/myai.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/myai.example.com/privkey.pem;

    # Match the app's upload limit (MAX_UPLOAD_BYTES = 40 MB).
    client_max_body_size 40m;

    # Long Ollama generations must not be killed by nginx.
    proxy_read_timeout    1h;
    proxy_send_timeout    1h;
    send_timeout          1h;

    location / {
        proxy_pass         http://myai_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        # Stream Ollama tokens to the browser as they arrive.
        proxy_buffering    off;
        proxy_cache        off;
    }
}
