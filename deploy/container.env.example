# Copy this file to the project root as .env, or export the variables in the
# shell before running `docker compose up -d`.
#
# Keep secrets out of screenshots and shared logs.

MYAI_PORT=3000
MYAI_BIND_ADDR=0.0.0.0
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_BIND_ADDR=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BIND_ADDR=127.0.0.1

MYAI_CONTAINER_OLLAMA_URL=http://ollama:11434
MYAI_CONTAINER_QDRANT_URL=http://qdrant:6333
OLLAMA_MODEL=gemma4:e2b
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# Generate a real deployment value with: openssl rand -hex 32
ADMIN_TOKEN=

# Generate a real deployment value with: openssl rand -hex 32
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=myai_notebook_chunks
QDRANT_VECTOR_NAME=dense_bge_m3

DEPARTMENT_VECTOR_BACKEND=qdrant
DEPARTMENT_LEXICAL_BACKEND=sqlite
SQLITE_FTS_PATH=data/indexes/department-rag.sqlite

MAX_JSON_BYTES=80mb
MAX_UPLOAD_BYTES=41943040
MAX_CONTEXT_CHARS=24000
NOTEBOOK_QUERY_BUDGET=12000

QUERY_EXPANSION_ENABLED=true
DOC_ANALYSIS_ENABLED=true
RAG_RERANK_ENABLED=false
RETRIEVAL_LOG_ENABLED=true

TRUST_PROXY=false
RATE_LIMIT_KEY_HEADER=
