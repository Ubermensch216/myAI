{
  "name": "ollama-document-chatter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:log": "node server/index.js > server/log/server.log 2> server/log/server.err.log",
    "dev": "node --watch server/index.js",
    "test": "npm run test:smoke",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:smoke:log": "node scripts/smoke-test.mjs > server/log/server-smoke.log 2> server/log/server-smoke.err.log",
    "test:xlsx": "node scripts/xlsx-visualization-test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "test:ci": "npm run test:xlsx && npm run test:smoke",
    "rag:check": "node scripts/check-department-rag-index.mjs",
    "rag:rebuild": "node scripts/rebuild-department-rag-index.mjs",
    "rag:quality-test": "node scripts/rag-quality-test.mjs",
    "rag:quality-test:quick": "node scripts/rag-quality-test.mjs --quick --k 10",
    "rag:backup": "node scripts/backup-department-rag.mjs",
    "rag:restore": "node scripts/restore-department-rag.mjs"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "express": "^4.18.3",
    "fast-xml-parser": "^5.2.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.1",
    "multer": "^2.0.0",
    "pdf-parse": "^1.1.1"
  }
}
