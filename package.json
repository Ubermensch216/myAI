{
  "name": "myAI",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:log": "node server/index.js > server/log/server.log 2> server/log/server.err.log",
    "dev": "node --watch server/index.js",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "test": "npm run test:readability && npm run test:evidence && npm run test:composer && npm run test:law-review-view && npm run test:law && npm run test:prompt-router && npm run test:mindmap && npm run test:grc && npm run test:grc-pdf && npm run test:hwpx && npm run test:hierarchical-chunk && npm run test:hierarchical-rag && npm run test:smoke",
    "test:hwpx": "node scripts/hwpx-parser-test.mjs",
    "test:hierarchical-chunk": "node scripts/hierarchical-chunk-test.mjs",
    "test:hierarchical-rag": "node scripts/hierarchical-rag-test.mjs",
    "test:grc": "node scripts/grc-review-test.mjs",
    "test:grc-pdf": "node scripts/grc-report-pdf-test.mjs",
    "test:readability": "node scripts/answer-readability-test.mjs",
    "test:evidence": "node scripts/evidence-summary-test.mjs",
    "test:composer": "node scripts/composer-layout-test.mjs",
    "test:law-review-view": "node scripts/law-review-view-test.mjs",
    "test:law": "node scripts/law-unit-test.mjs && node scripts/law-parser-test.mjs && node scripts/law-intent-eval.mjs && node scripts/kg-law-test.mjs && node scripts/compliance-unit-test.mjs",
    "test:mindmap": "node scripts/mindmap-test.mjs",
    "test:law:parser": "node scripts/law-parser-test.mjs",
    "test:law:intent": "node scripts/law-intent-eval.mjs",
    "test:law:kg": "node scripts/kg-law-test.mjs",
    "test:compliance": "node scripts/compliance-unit-test.mjs",
    "test:prompt-router": "node scripts/prompt-router-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:smoke:log": "node scripts/smoke-test.mjs > server/log/server-smoke.log 2> server/log/server-smoke.err.log",
    "test:studio-graph": "node scripts/studio-graph-e2e.mjs",
    "test:studio-document": "node scripts/studio-document-test.mjs",
    "test:source-workflow": "node scripts/source-workflow-test.mjs",
    "test:xlsx": "node scripts/xlsx-visualization-test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "test:ci": "npm run test:xlsx && npm run test:smoke",
    "rag:check": "node scripts/check-department-rag-index.mjs",
    "rag:rebuild": "node scripts/rebuild-department-rag-index.mjs",
    "rag:quality-test": "node scripts/rag-quality-test.mjs",
    "rag:quality-test:quick": "node scripts/rag-quality-test.mjs --quick --k 10",
    "rag:backup": "node scripts/backup-department-rag.mjs",
    "rag:restore": "node scripts/restore-department-rag.mjs",
    "vendor:copy": "node scripts/copy-vendor.mjs",
    "docker:build": "docker compose build",
    "docker:update": "docker compose pull qdrant ollama && docker compose build --pull app && docker compose up -d",
    "docker:config": "docker compose config",
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f app",
    "docker:pull-models": "docker compose exec ollama ollama pull gemma4:e2b && docker compose exec ollama ollama pull bge-m3",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.17.0",
    "cytoscape": "^3.33.3",
    "express": "^4.18.3",
    "fast-xml-parser": "^5.2.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.1",
    "multer": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.2",
    "ace-builds": "^1.44.0",
    "playwright": "^1.59.1",
    "svelte": "^4.2.12",
    "svelte-preprocess": "^5.1.3",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
    "vite": "^5.2.2"
  }
}
